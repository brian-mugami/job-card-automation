# ─── REQUIRED IN PRODUCTION ────────────────────────────────────────────────
# These three must have real, strong values before you go live. Defaults
# below are safe for local dev only.

LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:your-local-password@localhost:5432/job_card_db

# Generate with: openssl rand -hex 48
APP_SECRET_KEY=change-this-local-secret-before-sharing

# Comma-separated list of public origins. Use "*" only for local development.
# Production example: CORS_ALLOW_ORIGINS=https://app.yourgarage.com
CORS_ALLOW_ORIGINS=*

# ─── RECOMMENDED FOR HOSTED DEPLOYS ─────────────────────────────────────────

# Hide Swagger / ReDoc / OpenAPI on public deploys. Flip to "true" only on
# local dev or behind admin-only auth.
EXPOSE_API_DOCS=false

# Optional one-time secret used to bootstrap the first admin account from a
# non-loopback origin (i.e. through the public domain). Leave blank if you
# can SSH into the API container and bootstrap from there; set to a random
# string if you'd rather sign in via the public URL with the secret in the
# Streamlit form. Remove the value once the first admin exists.
# Generate with: openssl rand -hex 24
BOOTSTRAP_SECRET=

# ─── URLs ──────────────────────────────────────────────────────────────────

# Where the Streamlit frontend lives — embedded in outbound password-reset
# links etc. In production, set this to your real customer-facing URL.
FRONTEND_URL=http://localhost:8501

# Where the Streamlit container reaches the FastAPI container. On Easypanel
# this is typically http://<project>_<api-service>:8000 for internal traffic.
API_BASE_URL=http://localhost:8000

# ─── Tokens ────────────────────────────────────────────────────────────────

TOKEN_TTL_MINUTES=720
PASSWORD_RESET_TTL_MINUTES=30

# ─── SMTP (outbound email) ─────────────────────────────────────────────────
# Set SMTP_ENABLED=true after pasting working credentials. Gmail users:
# create an App Password under your Google account → Security → 2-Step
# Verification → App passwords (NOT your normal password).

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=Job Card Automation System
SMTP_TIMEOUT_SECONDS=8

# ─── Invoice / PDF branding ────────────────────────────────────────────────

PDF_COMPANY_NAME=Your Garage Name
PDF_COMPANY_ADDRESS=Your garage address
PDF_COMPANY_PHONE=Your phone number
PDF_COMPANY_EMAIL=your-email@example.com
PDF_CURRENCY=KES
